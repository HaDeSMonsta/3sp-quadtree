default:
	@just --list

apply:
	tofu apply -auto-approve

apply-server:
	tofu apply -auto-approve -target=google_compute_instance.bench-vm

restart:
	tofu apply -auto-approve -replace=google_compute_instance.bench-vm

destroy:
	tofu destroy -auto-approve

destroy-server:
	tofu destroy -auto-approve -target=google_compute_instance.bench-vm

move:
	gcloud compute scp ./clone.sh workhorse:~/
	gcloud compute scp ../dwd.tar.gz workhorse:~/
	gcloud compute scp ../simra.tar.gz workhorse:~/
